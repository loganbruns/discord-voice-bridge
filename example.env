# discord-voice-bridge configuration
# Copy to .env (for `node --env-file=.env server.mjs`) or use directly as a
# systemd EnvironmentFile. Required variables are marked; everything else has
# a working default.

# --- Discord (required) -----------------------------------------------
# Bot token from https://discord.com/developers/applications -> Bot.
# Either inline (fine for a private .env) or a file with the token as its
# only line (recommended for systemd; chmod 600).
#DISCORD_TOKEN=
#DISCORD_TOKEN_FILE=/path/to/discord.token
# Voice channel to live in (right-click the channel -> Copy Channel ID;
# requires Developer Mode in Discord's Advanced settings).
VOICE_CHANNEL_ID=
# Optional — resolved from the channel when omitted.
#GUILD_ID=

# --- Chat backend (LLM_MODEL required) --------------------------------
# Any OpenAI-compatible /v1/chat/completions endpoint. Bare host or trailing
# /v1 both work. Default targets local Ollama.
#LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=
# 1 (default) = the bridge keeps the conversation in memory and sends the
#   full message list — right for stateless endpoints (Ollama, llama.cpp
#   server, vLLM, LM Studio, OpenAI, ...).
# 0 = the endpoint remembers the session itself (e.g. openclaw's gateway,
#   which keys sessions on the `user` field) — only the newest message is sent.
#LLM_KEEP_HISTORY=1
# OpenAI `user` field; also the session key for stateful endpoints.
#LLM_USER=discord-voice
# Per-request model override, for backends that key the model on a header —
# e.g. openclaw's gateway takes `model: openclaw/<agent>` and an
# `x-openclaw-model` header to override the model for one request.
# Both must be set to activate.
#LLM_MODEL_HEADER=x-openclaw-model
#LLM_MODEL_OVERRIDE=
# Speak the bot's own posts in the voice channel's text chat (announce path
# for agent backends whose background work finishes outside a stream).
#SPEAK_CHANNEL_MESSAGES=1
# When the backend runs a tool-using agent loop (e.g. openclaw), the stream
# carries the model's between-tools narration as ordinary text. A silence
# longer than this (ms) between deltas means a tool round just ran: drop the
# unsent queue so only the final answer is spoken. 0 disables.
#SPEAK_GAP_DROP_MS=2000
# Only needed if the endpoint requires auth. Omit for local servers.
#LLM_API_KEY=
#LLM_API_KEY_FILE=/path/to/api.key

# --- Local tools (WHISPER_MODEL, PIPER_MODEL required) ----------------
# ffmpeg: any recent build on PATH.
#FFMPEG_BIN=ffmpeg
# whisper.cpp CLI (whisper-cli) + a ggml model from its releases page.
# ggml-base.en is small and fast; use a multilingual model for non-English.
#WHISPER_BIN=whisper-cli
WHISPER_MODEL=/path/to/ggml-base.en.bin
# piper TTS: the `piper` binary, or a full command like "python3 -m piper".
# Voices: https://github.com/rhasspy/piper/blob/master/VOICES.md (download
# the .onnx + .onnx.json pair).
#PIPER_BIN=piper
PIPER_MODEL=/path/to/en_US-lessac-medium.onnx

# --- Behaviour (all optional) -----------------------------------------
# Override the built-in speaking-style system prompt if you like.
#VOICE_HINT=
#TTS_MAX_CHARS=1200
#STT_MIN_MS=400       # drop captures shorter than this (clicks, sub-words)
#STT_DRAIN_MS=1100    # this much silence after speech ends the utterance
#STT_MAX_MS=25000     # hard cap per utterance
#TURN_IDLE_MS=120000  # abort the chat stream if no chunk arrives for this long
#TURN_MAX_MS=420000   # hard cap per chat turn
#HISTORY_MAX_MESSAGES=40

# --- Testing / debugging (optional) -----------------------------------
#FORCE_JOIN=1             # join at startup, speak HELLO_LINE, leave
#VOICE_TEST_QUESTION=Say one short sentence about pineapples.
#DEBUG_VOICE=1            # verbose voice-connection + stream logging
